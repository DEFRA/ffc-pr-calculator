{% extends '_layout.njk' %}

{% set pageTitle = "Sorry, there is a problem with the service" %}

{% block pageTitle %}{{ pageTitle }} - {{ serviceName }}{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">{{ pageTitle }}</h1>
      <p class="govuk-body">Try again later.</p>
      <p class="govuk-body">
            If you require help in using this calculator, 
            please call the Rural Payments helpline on <a href="tel:03000 200 301">03000 200 301</a>
      </p>
    </div>
  </div>
{% endblock %}

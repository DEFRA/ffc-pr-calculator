{% extends "_layout.njk" %}

{% from "govuk/components/tabs/macro.njk" import govukTabs %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% set pageTitle = "Delinked payment calculation" %}

{% block pageTitle %}{{ pageTitle }} - {{ serviceName }}{% endblock %}

{% block beforeContent %}
  <div class="govuk-width-container">
    {{
      govukBackLink({
        text: "Back",
        href: "/delinked-calculator"
      })
    }}
  </div>
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {{
        govukPanel({
          titleText: pageTitle
        })
      }}

      {% set tabs = [] %}

      {% for year in model.years %}
        {% set content %}
          <div id="year{{ year }}">
            <p class="govuk-body">{{ model.year[year].confirmation }}</p>

            {{ govukTable(model.year[year].paymentSummary) }}

            <p class="govuk-body">{{ model.year[year].schedule.text }}</p>

            {{ govukTable(model.year[year].reduction) }}
            {{ govukTable(model.year[year].paymentBand) }}
          </div>
        {% endset %}

        {%
          set tabs = (tabs.push({
            id: 'year' ~ year,
            label: year,
            panel: {
              html: content
            }
          }), tabs)
        %}
      {% endfor %}

      {{
        govukTabs({
          items: tabs
        })
      }}
    </div>
  </div>
{% endblock %}
